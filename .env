# ============================================================
#  .env — cấu hình môi trường THỰC TẾ
# ============================================================

SERVER_PORT=8081

# ── OPTION 1: POSTGRESQL DOCKER (MẶC ĐỊNH ĐANG CHẠY) ──
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecomart_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword
SPRING_DOCKER_COMPOSE_ENABLED=false

# ── OPTION 2: MICROSOFT SQL SERVER (DÀNH CHO TEAM NẾU DÙNG SQL SERVER) ──
# SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=ecomart_db;encrypt=true;trustServerCertificate=true
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=YourStrong@Passw0rd

# ── DÙNG CHUNG ──
APP_JWT_SECRET=9a4f2c8d7e1b5a3f6c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b
APP_JWT_EXPIRATION_MS=86400000
