# ============================================================
#  .env — cấu hình môi trường THỰC TẾ (KHÔNG commit lên git!)
#  Được tạo từ .env.example. Mọi giá trị đang dùng default cho dev.
# ============================================================

# ── 1) CHẠY LOCAL (Maven / IDE — H2 in-memory) ──
SERVER_PORT=8081
SPRING_DATASOURCE_URL=jdbc:h2:mem:ecomartdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DOCKER_COMPOSE_ENABLED=false

# ── 2) CHẠY BẰNG DOCKER (docker compose up -d --build) ──
APP_PORT=8081
POSTGRES_DB=ecomart_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432

# ── 3) DÙNG CHUNG — ⚠️ ĐỔI secret này trước khi deploy thật! ──
APP_JWT_SECRET=9a4f2c8d7e1b5a3f6c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b
APP_JWT_EXPIRATION_MS=86400000
