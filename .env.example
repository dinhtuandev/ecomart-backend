# ============================================================
#  .env.example — MẪU cấu hình môi trường (file này COMMIT lên git)
#
#  Cách dùng: copy thành file .env rồi chỉnh theo nhu cầu.
#  File .env thật KHÔNG được commit (đã ignore trong .gitignore).
#
#  ⚠️ Mọi giá trị dưới đây là MẶC ĐỊNH cho môi trường DEV.
#     Đổi JWT secret và password DB trước khi deploy thật!
# ============================================================

# ────────────────────────────────────────────────────────────
#  1) CHẠY LOCAL (Maven / IDE — dùng H2 in-memory, không cần Docker)
#     Được springboot3-dotenv load khi chạy ./mvnw spring-boot:run
# ────────────────────────────────────────────────────────────

# Cổng khi chạy local.
# ⚠️ LƯU Ý: Docker đọc APP_PORT (phần 2), KHÔNG đọc biến này.
SERVER_PORT=8081

# H2 in-memory mặc định cho dev
SPRING_DATASOURCE_URL=jdbc:h2:mem:ecomartdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Muốn chạy local với PostgreSQL thật thì bỏ comment 3 dòng dưới:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecomart_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgrespassword

# true: tự động start PostgreSQL từ compose.yaml (cần Docker Desktop đang chạy)
# false: bỏ qua Docker Compose, dùng datasource ở trên
SPRING_DOCKER_COMPOSE_ENABLED=false

# ────────────────────────────────────────────────────────────
#  2) CHẠY BẰNG DOCKER (docker compose up -d --build)
#     compose.yaml đọc trực tiếp các biến này.
#     Không có .env vẫn chạy được nhờ giá trị mặc định (sau dấu :-)
# ────────────────────────────────────────────────────────────

# Port app trên host (map vào cổng 8081 trong container)
APP_PORT=8081

# PostgreSQL
POSTGRES_DB=ecomart_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432

# ────────────────────────────────────────────────────────────
#  3) DÙNG CHUNG (cả local lẫn Docker)
# ────────────────────────────────────────────────────────────

# JWT — ⚠️ Secret phải dài >= 32 bytes, BẮT BUỘC đổi trước khi deploy thật!
# (giá trị hiện tại chỉ là placeholder để minh họa)
APP_JWT_SECRET=change-me-32-char-min-secret-key-please
APP_JWT_EXPIRATION_MS=86400000
