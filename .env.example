# ==============================================================================
# EcoMart Backend - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual values.
# ==============================================================================

# Server Port
SERVER_PORT=8081

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecomart_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password

# JWT Security Configuration
APP_JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000

# Resend Email Service Configuration
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=EcoMart <onboarding@resend.dev>

# VNPay Payment Gateway Configuration (Sandbox)
VNPAY_TMN_CODE=your_vnpay_tmn_code_here
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/checkout/payment-return

# SePay VietQR Gateway Configuration
SEPAY_API_KEY=your_sepay_api_key_here
SEPAY_ACCOUNT_NUMBER=your_bank_account_number
SEPAY_BANK=MBBank
SEPAY_QR_TEMPLATE=https://qr.sepay.vn/img?acc={acc}&bank={bank}&amount={amount}&des={des}
