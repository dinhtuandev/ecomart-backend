# ── Server ──
# Cổng ứng dụng chạy (mặc định dự án dùng 8081)
SERVER_PORT=8081

# ── Database (mặc định dùng H2 in-memory cho dev) ──
SPRING_DATASOURCE_URL=jdbc:h2:mem:ecomartdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# ── Đổi sang PostgreSQL khi lên production (bỏ comment) ──
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecomart_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgrespassword

# ── JWT ──
# ⚠️ Secret tối thiểu 32 bytes. BẮT BUỘC đổi khi lên production!
APP_JWT_SECRET=change-me-32-char-min-secret-key-please
APP_JWT_EXPIRATION_MS=86400000

# ── Docker Compose ──
# true: tự động khởi chạy PostgreSQL từ compose.yaml (cần Docker Desktop đang chạy)
# false: bỏ qua Docker, dùng datasource phía trên
SPRING_DOCKER_COMPOSE_ENABLED=false
